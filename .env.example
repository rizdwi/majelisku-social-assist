# ==========================================
# Majelisku Social Assist Environment Config
# ==========================================

# 1. Kredensial Meta Threads API (diisi mandiri oleh user)
# Didapatkan dari Meta Developer Dashboard (Graph API)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
THREADS_API_BASE_URL=https://graph.threads.net/v1.0

# 2. Kredensial AI Model (Anthropic / OpenAI / OpenRouter)
# Contoh model: claude-3-5-sonnet-20241022, gpt-4o-mini, atau deepseek/deepseek-chat
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
# AI_BASE_URL=https://openrouter.ai/api/v1  # Opsional jika menggunakan OpenRouter

# 3. Pengaturan Pipeline & Ambang Batas Skor
SCORE_THRESHOLD=3
FETCH_INTERVAL_HOURS=1
